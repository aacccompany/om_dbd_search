<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dbd" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dbd</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="DBD API Search" string="DBD API Search" name="om_dbd_search">
                    <block title="DBD Connection Settings" name="dbd_connection_block">
                        <setting string="API Configuration" help="Enter your DBD Data Warehouse API Token">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="dbd_api_token" string="API Token"/>
                                    <field name="dbd_api_token" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>